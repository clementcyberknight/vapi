# ==============================================================================
# Required: Hugging Face Access Token
# NCAIR1/NigerianAccentedEnglish is an auto-gated repository:
#   1. Accept terms at https://huggingface.co/NCAIR1/NigerianAccentedEnglish
#   2. Create a Read token at https://huggingface.co/settings/tokens
# ==============================================================================
HF_TOKEN=hf_your_token_here

# ==============================================================================
# Model & Inference Engine
# ==============================================================================
MODEL_ID=NCAIR1/NigerianAccentedEnglish
# ctranslate2 = faster-whisper (4-6x faster, ~60% lower RAM) | transformers = PyTorch fallback
ENGINE=ctranslate2
# auto | cpu | cuda
DEVICE=auto
# auto -> float32 on CPU (lossless fine-tune accuracy), float16 on CUDA | int8 | int16 | float16 | float32
COMPUTE_TYPE=auto
# Download, convert, and warm up the model during server startup
PRELOAD_MODEL=true
# Delete raw HF snapshot (~1 GB) after one-time lossless CT2 conversion to save disk
DELETE_HF_SNAPSHOT_AFTER_CONVERT=true
# Persistent cache and disk-backed upload scratch inside the container volume
CACHE_DIR=/cache
UPLOAD_TMP_DIR=/cache/tmp

# ==============================================================================
# Decoding, Accuracy & Speed Tuning
# ==============================================================================
# Keeping DEFAULT_LANGUAGE=en skips Whisper's extra 30s language-detection pass
DEFAULT_LANGUAGE=en
# 5 = OpenAI Whisper accuracy standard, 1 = fastest greedy
BEAM_SIZE=5
# >1.0 explores more beam candidates for higher accuracy on accented speech
PATIENCE=1.5
# Stops fine-tuned Whisper repetition loops (which also cause 448-token slowdowns)
REPETITION_PENALTY=1.1
NO_REPEAT_NGRAM_SIZE=3
# Strips sub-80Hz mains hum/rumble and boosts quiet mobile voice notes (spike-resistant)
NORMALIZE_AUDIO=true
# Enable Silero VAD to strip silence without chopping quiet or mid-sentence pauses
VAD_FILTER=true
VAD_THRESHOLD=0.35
VAD_MIN_SPEECH_MS=200
VAD_MIN_SILENCE_MS=1000
VAD_SPEECH_PAD_MS=400
# Use BatchedInferencePipeline for long files (>= 15 seconds)
ENABLE_BATCHED_INFERENCE=true
BATCH_SIZE=2
# Used by transformers fallback backend (seconds per chunk)
CHUNK_LENGTH_S=30

# ==============================================================================
# Docker Resource Limits (Tuned for 6-core AMD EPYC AVX2, Strict 3 GB RAM Cap)
# Subprocess CT2 conversion reclaims ~1.4 GB PyTorch RAM before WhisperModel loads;
# steady-state lossless float32 idles at ~1.2 GB and stays <= 2.2 GB under load.
# ==============================================================================
HOST_PORT=8000
TORCH_INDEX_URL=https://download.pytorch.org/whl/cpu
CPU_LIMIT=4.0
CPU_RESERVATION=1.0
MEMORY_LIMIT=3G
MEMORY_RESERVATION=1536M
# Keep NUM_WORKERS * CPU_THREADS roughly <= CPU_LIMIT
CPU_THREADS=4
NUM_WORKERS=1
MALLOC_ARENA_MAX=2
CT2_USE_EXPERIMENTAL_PACKED_GEMM=1

# ==============================================================================
# Concurrency, Disk-Backed Queue & Upload Guardrails
# Safely handles up to 20 concurrent 25 MB voice notes strictly within 3G RAM:
# uploads stream to disk (/cache/tmp) and decode just-in-time inside the semaphore.
# ==============================================================================
# Active simultaneous inferences in RAM (1 avoids L3 thrash on 1 CT2 worker & caps peak RAM)
MAX_CONCURRENT_TRANSCRIPTIONS=1
# Total in-flight + queued uploads before returning HTTP 503 + Retry-After
MAX_QUEUED_REQUESTS=20
# Max seconds a queued upload waits for an inference slot
QUEUE_TIMEOUT_SECONDS=300
MAX_UPLOAD_SIZE_MB=25

# ==============================================================================
# Real-Time WebSocket Streaming (WS /api/v1/stream)
# ==============================================================================
MAX_WS_CONNECTIONS=8
STREAM_PARTIAL_INTERVAL_MS=600
STREAM_SILENCE_MS=800
STREAM_MIN_SPEECH_MS=300
STREAM_MAX_UTTERANCE_S=20.0
STREAM_ENERGY_THRESHOLD=0.012

# ==============================================================================
# Security, CORS & Observability
# ==============================================================================
# Leave blank to disable auth; set a strong secret for production deployments
API_KEY=
# JSON array of allowed origins (e.g. ["https://app.example.com"])
CORS_ORIGINS=["*"]
ENVIRONMENT=production
LOG_LEVEL=INFO
# json (recommended for production) | text (human-readable local logs)
LOG_FORMAT=json

# ==============================================================================
# Optional: Cloudflare R2 Voice Recording Backup (S3-Compatible API)
# Leave blank to disable R2 backups.
# ==============================================================================
R2_ACCOUNT_ID=
# Optional override (defaults to https://<R2_ACCOUNT_ID>.r2.cloudflarestorage.com)
R2_ENDPOINT_URL=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
R2_REGION=auto
R2_KEY_PREFIX=voices
# Optional custom domain / public bucket URL (e.g. https://audio.example.com)
R2_PUBLIC_BASE_URL=

# ==============================================================================
# Optional: Supabase Database Audit Logging
# Run supabase/migrations/20261126000000_create_voice_transcriptions.sql first.
# Use a server-side Secret key (sb_secret_...) or service_role key — never anon!
# Leave blank to disable Supabase logging.
# ==============================================================================
SUPABASE_URL=
SUPABASE_SECRET_KEY=
SUPABASE_TABLE=voice_transcriptions
ARCHIVE_CONCURRENCY=4
ARCHIVE_MAX_QUEUE_SIZE=64
ARCHIVE_MAX_RETRIES=3
ARCHIVE_WEBSOCKET_SEGMENTS=true
