# ==============================================================================
# Required: Hugging Face token (NCAIR1/NigerianAccentedEnglish is gated)
# 1. Accept terms at https://huggingface.co/NCAIR1/NigerianAccentedEnglish
# 2. Create a Read token at https://huggingface.co/settings/tokens
# ==============================================================================
HF_TOKEN=hf_your_token_here

# Inference Engine (ctranslate2 = faster-whisper, 4-6x faster & lower RAM)
MODEL_ID=NCAIR1/NigerianAccentedEnglish
ENGINE=ctranslate2
DEVICE=auto
COMPUTE_TYPE=auto
PRELOAD_MODEL=true
# Set true on small-disk servers to delete raw HF weights after CT2 conversion
DELETE_HF_SNAPSHOT_AFTER_CONVERT=false

# Speed & Decoding Tuning
# Keeping DEFAULT_LANGUAGE=en skips Whisper's extra language-detection pass
DEFAULT_LANGUAGE=en
BEAM_SIZE=2
VAD_FILTER=true
ENABLE_BATCHED_INFERENCE=true
BATCH_SIZE=8

# Docker Resource Limits (tune to your server capacity)
# Note: First boot needs ~2.5-3G RAM briefly for one-time CT2 conversion;
# steady-state int8 CTranslate2 uses ~500-800 MB RAM.
CPU_LIMIT=2.0
CPU_RESERVATION=0.5
MEMORY_LIMIT=3G
MEMORY_RESERVATION=1G
CPU_THREADS=2
NUM_WORKERS=1

# Concurrency & Upload Guardrails
HOST_PORT=8000
MAX_CONCURRENT_TRANSCRIPTIONS=2
MAX_UPLOAD_SIZE_MB=25

# Real-Time WebSocket Streaming (/api/v1/stream)
MAX_WS_CONNECTIONS=8
STREAM_PARTIAL_INTERVAL_MS=600
STREAM_SILENCE_MS=800
STREAM_MAX_UTTERANCE_S=20.0

# Security & Observability
# Leave blank to disable auth; set a strong secret for production deployments
API_KEY=
LOG_LEVEL=INFO
LOG_FORMAT=json
